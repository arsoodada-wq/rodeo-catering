# ── Database ────────────────────────────────────────────────────────────
# Postgres connection string. For local dev we recommend a free cloud
# Postgres project (Neon: https://neon.tech or Supabase: https://supabase.com) —
# create a project, copy its connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth (Auth.js / NextAuth v5) ───────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="REQUIRES_BUSINESS_CONFIRMATION_generate_a_real_secret"
# Base URL of this deployment. Set to your real catering domain in production.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin account, created by `npm run db:seed`. Change the password
# after first login — there is no signup flow by design.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-after-first-login"

# ── AI Catering Concierge (optional — wizard works without it) ────────
# Anthropic API key (https://console.anthropic.com). If unset, the /catering
# page just shows the guided step-by-step builder; the "Chat with Us" tab
# and its tab switcher don't render at all — nothing breaks either way.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-sonnet-5 — a solid balance of quality and
# cost for a chat that's mostly structured extraction and tool calls. Set
# to claude-opus-5 for higher-quality conversation at higher cost, or
# claude-haiku-4-5 to cut cost further.
ANTHROPIC_MODEL=""

# ── Transactional email (new-lead notifications) ───────────────────────
# https://resend.com — free tier available. Wired up in src/lib/email.ts:
# every new catering lead (wizard or AI concierge) emails
# ADMIN_NOTIFICATION_EMAIL. Leave RESEND_API_KEY blank to log the email to
# the console instead of sending it (dev-safe default) — nothing else
# breaks either way. Leave ADMIN_NOTIFICATION_EMAIL blank to disable the
# notification entirely (a lead is still saved either way; only the
# email is skipped).
RESEND_API_KEY=""
EMAIL_FROM="Rodeo Catering <catering@REQUIRES_BUSINESS_CONFIRMATION_domain.com>"
ADMIN_NOTIFICATION_EMAIL="info@rodeoburgersandchicken.com"

# ── Payments (Stripe) — reserved names only, NOT wired into any code yet ─
# No payment flow exists in this app (quotes are sent as a link and paid
# for outside the site); these are placeholders for a future phase, not a
# feature you can turn on by setting them.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Analytics / tracking — reserved names only, NOT wired into any code yet ─
# No analytics script is rendered anywhere in this app; these are
# placeholders for a future phase, not a feature you can turn on by
# setting them.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
